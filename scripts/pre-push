#!/bin/sh
# Refuse a push whose new commits use the wrong address or a trailer.
root=$(git rev-parse --show-toplevel)
if [ -z "${GITHUB_ACTIONS:-}" ] && [ -z "${AUTHOR_EMAIL:-}" ]; then
  AUTHOR_EMAIL=$(git config --get user.email || true)
  export AUTHOR_EMAIL
fi
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  python3 "$root/scripts/check_authorship.py" --range "$range" || exit 1
done
exit 0
