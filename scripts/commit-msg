#!/bin/sh
# Local commits must use the address from AUTHOR_EMAIL, or git config.
root=$(git rev-parse --show-toplevel)
if [ -z "${GITHUB_ACTIONS:-}" ] && [ -z "${AUTHOR_EMAIL:-}" ]; then
  AUTHOR_EMAIL=$(git config --get user.email || true)
  export AUTHOR_EMAIL
fi
exec python3 "$root/scripts/check_authorship.py" --commit-msg "$1"
